{
  "name": "typeweld-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "typeweld",
    "effect-runtime",
    "vscode-extension"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run test --workspaces --if-present",
    "typecheck": "tsc -b --noEmit tsconfig.json && tsc --noEmit -p vscode-extension/typescript-plugin/tsconfig.json"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.78",
    "@types/node": "^25.9.2",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "typescript-language-server": "5.3.0",
    "vitest": "4.1.8"
  }
}
