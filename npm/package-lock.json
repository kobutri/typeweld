{
  "name": "rust-ts-integration-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rust-ts-integration-workspace",
      "workspaces": [
        "effect-runtime",
        "language-server-wrapper"
      ],
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "effect-runtime": {
      "name": "@rust-ts-integration/effect-runtime",
      "version": "0.0.0"
    },
    "language-server-wrapper": {
      "name": "@rust-ts-integration/language-server",
      "version": "0.0.0",
      "bin": {
        "api-ls": "src/index.ts"
      }
    },
    "node_modules/@rust-ts-integration/effect-runtime": {
      "resolved": "effect-runtime",
      "link": true
    },
    "node_modules/@rust-ts-integration/language-server": {
      "resolved": "language-server-wrapper",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    }
  }
}
