{
  "name": "@typeweld/language-server",
  "version": "0.0.0",
  "description": "npm launcher for the Typeweld language server.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/typeweld/typeweld",
    "directory": "npm/language-server-wrapper"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "typeweld-ls": "./src/index.ts"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "prepare:binary": "node scripts/prepare-package.mjs",
    "test": "npm run typecheck && npm run test:wrapper",
    "test:wrapper": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
