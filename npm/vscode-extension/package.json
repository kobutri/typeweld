{
  "name": "typeweld-vscode",
  "displayName": "Typeweld",
  "description": "VS Code client for the Typeweld language server.",
  "version": "0.0.10",
  "private": true,
  "publisher": "kobutri",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobutri/typeweld.git",
    "directory": "npm/vscode-extension"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/typeweld.toml",
    "onLanguage:rust",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "files": [
    "bin",
    "dist",
    "LICENSE.md",
    "README.md",
    "node_modules/@typeweld/typescript-plugin/**",
    "package.json"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.js && npm run build --prefix typescript-plugin && node scripts/stage.mjs",
    "compile": "npm run typecheck && npm run build",
    "package:vsix": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --prefix typescript-plugin",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vscode-languageclient": "^10.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "typeweld.server.restart",
        "title": "Restart Language Server",
        "category": "Typeweld"
      },
      {
        "command": "typeweld.integration.enable",
        "title": "Enable rust-analyzer Integration",
        "category": "Typeweld"
      },
      {
        "command": "typeweld.integration.disable",
        "title": "Disable rust-analyzer Integration",
        "category": "Typeweld"
      }
    ],
    "configuration": {
      "title": "Typeweld",
      "properties": {
        "typeweld.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the typeweld binary. Leave empty to discover it via TYPEWELD_LS_BINARY, PATH, the binary bundled with the extension, or local cargo builds."
        },
        "typeweld.server.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to `typeweld lsp`."
        },
        "typeweld.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the typeweld language server."
        }
      }
    },
    "typescriptServerPlugins": [
      {
        "name": "@typeweld/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  }
}
