{
  "name": "typeweld-vscode",
  "displayName": "Typeweld",
  "description": "VS Code client for the Typeweld language server.",
  "version": "0.0.5",
  "private": true,
  "publisher": "typeweld",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobutri/typeweld.git",
    "directory": "npm/vscode-extension"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "workspaceContains:.typeweld.json",
    "workspaceContains:typeweld.json",
    "workspaceContains:.typeweld-ls.json",
    "workspaceContains:typeweld-ls.json",
    "workspaceContains:target/api-contract/effect-v4/packages"
  ],
  "main": "./dist/extension.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "node_modules/@typeweld/typescript-plugin/**",
    "package.json"
  ],
  "scripts": {
    "compile": "npm run typecheck && vite build --config vite.config.mts --mode development",
    "package": "npm run build",
    "build": "npm run typecheck && vite build --config vite.config.mts --mode production && npm run build --prefix typescript-plugin",
    "package:vsix": "tsx scripts/package-vsix.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --prefix typescript-plugin",
    "vscode:prepublish": "npm run build",
    "watch": "vite build --config vite.config.mts --mode development --watch"
  },
  "dependencies": {
    "@typeweld/typescript-plugin": "file:./typescript-plugin"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "ovsx": "1.0.0",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vscode-languageclient": "^10.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "typeweld.languageServer.restart",
        "title": "Restart typeweld-ls",
        "category": "Typeweld"
      }
    ],
    "configuration": {
      "title": "Typeweld",
      "properties": {
        "typeweld.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the typeweld-ls language server client."
        },
        "typeweld.languageServer.command": {
          "type": "string",
          "default": "",
          "description": "Executable path or command name for typeweld-ls. Leave empty to use the bundled native binary."
        },
        "typeweld.languageServer.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to typeweld-ls."
        },
        "typeweld.languageServer.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables added when starting typeweld-ls."
        },
        "typeweld.languageServer.requiredWorkspaceMarkers": {
          "type": "array",
          "default": [
            ".typeweld.json",
            "typeweld.json",
            ".typeweld-ls.json",
            "typeweld-ls.json",
            ".api-ls.json",
            "api-ls.json",
            "target/api-contract/effect-v4/packages"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace marker paths that allow the typeweld-ls client to start. An empty list starts the client for every workspace folder."
        }
      }
    },
    "typescriptServerPlugins": [
      {
        "name": "@typeweld/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  }
}
