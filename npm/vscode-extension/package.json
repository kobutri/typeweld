{
  "name": "typeweld-vscode",
  "displayName": "Typeweld",
  "description": "VS Code client for the Typeweld language server.",
  "version": "0.0.4",
  "private": true,
  "publisher": "typeweld",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobutri/typeweld.git",
    "directory": "npm/vscode-extension"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "workspaceContains:.typeweld.json",
    "workspaceContains:typeweld.json",
    "workspaceContains:.typeweld-ls.json",
    "workspaceContains:typeweld-ls.json",
    "workspaceContains:target/api-contract/effect-v4/packages"
  ],
  "main": "./dist/extension.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "server",
    "package.json"
  ],
  "scripts": {
    "compile": "npm run typecheck && vite build --config vite.config.mts --mode development",
    "package": "npm run typecheck && vite build --config vite.config.mts --mode production",
    "package:vsix": "tsx scripts/ensure-out-dir.mts && vsce package --no-dependencies && tsx scripts/patch-vsix-typescript-plugin.mts",
    "prepare:server": "tsx scripts/prepare-package.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p typescript-plugin/tsconfig.json",
    "vscode:prepublish": "npm run package",
    "watch": "vite build --config vite.config.mts --mode development --watch"
  },
  "dependencies": {
    "@typeweld/language-server": "0.0.4",
    "ovsx": "1.0.0",
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/yauzl": "3.3.0",
    "@types/yazl": "3.3.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "ovsx": "1.0.0",
    "vite": "8.0.16",
    "yauzl": "3.3.2",
    "yazl": "3.3.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "typeweld.languageServer.restart",
        "title": "Restart typeweld-ls",
        "category": "Typeweld"
      }
    ],
    "configuration": {
      "title": "Typeweld",
      "properties": {
        "typeweld.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the typeweld-ls language server client."
        },
        "typeweld.languageServer.command": {
          "type": "string",
          "default": "",
          "description": "Executable path or command name for typeweld-ls. Leave empty to use the bundled npm launcher."
        },
        "typeweld.languageServer.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to typeweld-ls or to the bundled npm launcher."
        },
        "typeweld.languageServer.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables added when starting typeweld-ls. Use TYPEWELD_LS_BINARY here to point the bundled launcher at a local Rust binary."
        },
        "typeweld.languageServer.requiredWorkspaceMarkers": {
          "type": "array",
          "default": [
            ".typeweld.json",
            "typeweld.json",
            ".typeweld-ls.json",
            "typeweld-ls.json",
            ".api-ls.json",
            "api-ls.json",
            "target/api-contract/effect-v4/packages"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace marker paths that allow the typeweld-ls client to start. An empty list starts the client for every workspace folder."
        }
      }
    },
    "typescriptServerPlugins": [
      {
        "name": "@typeweld/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  }
}
