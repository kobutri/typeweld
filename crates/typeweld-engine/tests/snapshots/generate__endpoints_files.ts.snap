// Generated by typeweld. Do not edit.
import type { ApiClientError, BinaryRequestBody } from "@typeweld/effect-runtime"
import { decodeWithSchema, makeBinaryDownloadClient, makeBinaryUploadClient } from "@typeweld/effect-runtime"
import { Effect } from "@typeweld/effect-runtime/compat"
import { ApiConfig } from "../client"
import { User } from "../schemas"

export interface DownloadArgs {
  readonly name: string
}

export const downloadRoute = {
  method: "GET",
  path: "/files/{name}",
} as const

export const download = (args: DownloadArgs): Effect.Effect<Uint8Array, ApiClientError, ApiConfig> =>
  ApiConfig.use((config) => makeBinaryDownloadClient<DownloadArgs, never>(
    config,
    {
      method: "GET",
      path: "/files/{name}",
      encode: (args) => ({
        path: {
          name: args.name,
        },
      }),
    },
  )(args))

export interface UploadArgs {
  readonly body: BinaryRequestBody
}

export const uploadRoute = {
  method: "POST",
  path: "/files",
} as const

export const upload = (args: UploadArgs): Effect.Effect<User, ApiClientError, ApiConfig> =>
  ApiConfig.use((config) => makeBinaryUploadClient<UploadArgs, User, never>(
    config,
    {
      method: "POST",
      path: "/files",
      encode: (args) => ({
        body: args.body,
        bodyKind: "binary",
      }),
      decodeSuccess: (input) => decodeWithSchema(input, User),
    },
  )(args))
