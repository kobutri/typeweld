{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@typeweld/effect-runtime": [
        "../../../npm/effect-runtime/src/index.ts"
      ],
      "@typeweld/effect-runtime/compat": [
        "../../../npm/effect-runtime/src/compat.ts"
      ],
      "@typeweld/effect-runtime/*": [
