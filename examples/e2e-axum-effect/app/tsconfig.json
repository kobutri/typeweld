{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["DOM", "ES2022", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "typeRoots": ["../../../npm/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@typeweld/effect-runtime": [
        "../../../npm/effect-runtime/src/index.ts"
      ],
      "@typeweld/effect-runtime/compat": [
        "../../../npm/effect-runtime/src/compat.ts"
      ],
      "@typeweld/effect-runtime/*": [
        "../../../npm/effect-runtime/src/*"
      ],
      "@workspace/e2e-api": [
        "../../../target/api-contract/effect-v4/packages/_workspace_e2e-api/index.ts"
      ],
      "@workspace/e2e-api/*": [
        "../../../target/api-contract/effect-v4/packages/_workspace_e2e-api/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.mts"]
}
